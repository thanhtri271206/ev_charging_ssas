                <KeyColumn dwd:design-time-name="7a6adc33-365c-4910-bfd6-f1decba22bab">
                  <DataType>Date</DataType>
                  <Source xsi:type="ColumnBinding" dwd:design-time-name="902e6d59-015c-484f-a05b-e1f81ba18d25">
                    <TableID>dbo_fact_ev_charging</TableID>
