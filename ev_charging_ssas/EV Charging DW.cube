        <Measure dwd:design-time-name="006422a2-2b6e-41b4-98b2-9b8ed1ffaee6">
          <ID>Gas Price Per Gallon</ID>
          <Name>Gas Price Per Gallon</Name>
          <Source dwd:design-time-name="e3d9c19e-920f-4c6e-939f-3ee89e59b7c5">
            <DataType>Double</DataType>
            <Source xsi:type="ColumnBinding" dwd:design-time-name="bbeaa4a1-0d9b-4a8e-9912-c5220a56d141">
              <TableID>dbo_fact_ev_charging</TableID>
