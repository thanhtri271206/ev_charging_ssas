        <Dimension xsi:type="RegularMeasureGroupDimension" dwd:design-time-name="b2241f11-823b-433e-8c1e-2588291928f8">
          <CubeDimensionID>Dim Station</CubeDimensionID>
          <Attributes>
            <Attribute dwd:design-time-name="aa415377-c629-446a-8ac0-eecd9c23d267">
              <AttributeID>Station Key</AttributeID>
              <KeyColumns>
                <KeyColumn dwd:design-time-name="08eab8db-f682-485e-975f-33225f5712c1">
                  <DataType>Integer</DataType>
                  <Source xsi:type="ColumnBinding" dwd:design-time-name="1123a905-92b8-4994-b7b4-29e45eccf826">
                    <TableID>dbo_fact_ev_charging</TableID>
                    <ColumnID>station_key</ColumnID>
