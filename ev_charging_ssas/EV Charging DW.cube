  <Source dwd:design-time-name="3b06f340-35ad-4aaa-9df8-d992c5dfa4c9">
    <DataSourceViewID>EV Charging DW</DataSourceViewID>
  </Source>
  <MdxScripts>
    <MdxScript dwd:design-time-name="5bf85e14-5dfe-4ccd-abf8-194b6a25da97">
      <ID>MdxScript</ID>
      <Name>MdxScript</Name>
      <CreatedTimestamp>0001-01-01T00:00:00Z</CreatedTimestamp>
      <LastSchemaUpdate>0001-01-01T00:00:00Z</LastSchemaUpdate>
      <Commands>
        <Command>
          <Text>CALCULATE;

/* ===== S1. Measure co ban ===== */
CREATE MEMBER CURRENTCUBE.[Measures].[Avg Utilization] AS
    IIF([Measures].[Fact Ev Charging Count] = 0, NULL, [Measures].[Utilization Rate] / [Measures].[Fact Ev Charging Count]),
    FORMAT_STRING = "0.0000", VISIBLE = 1;

CREATE MEMBER CURRENTCUBE.[Measures].[Avg Wait] AS
    IIF([Measures].[Fact Ev Charging Count] = 0, NULL, [Measures].[Estimated Wait Time Mins] / [Measures].[Fact Ev Charging Count]),
    FORMAT_STRING = "0.00", VISIBLE = 1;

CREATE MEMBER CURRENTCUBE.[Measures].[Avg Session] AS
    IIF([Measures].[Fact Ev Charging Count] = 0, NULL, [Measures].[Avg Session Duration Mins] / [Measures].[Fact Ev Charging Count]),
    FORMAT_STRING = "0.0", VISIBLE = 1;

CREATE MEMBER CURRENTCUBE.[Measures].[Avg Price] AS
    IIF([Measures].[Fact Ev Charging Count] = 0, NULL, [Measures].[Current Price] / [Measures].[Fact Ev Charging Count]),
    FORMAT_STRING = "0.0000", VISIBLE = 1;

CREATE MEMBER CURRENTCUBE.[Measures].[Avg Gas] AS
    IIF([Measures].[Fact Ev Charging Count] = 0, NULL, [Measures].[Gas Price Per Gallon] / [Measures].[Fact Ev Charging Count]),
    FORMAT_STRING = "0.000", VISIBLE = 1;

CREATE MEMBER CURRENTCUBE.[Measures].[Avg Temperature] AS
    IIF([Measures].[Fact Ev Charging Count] = 0, NULL, [Measures].[Temperature F] / [Measures].[Fact Ev Charging Count]),
    FORMAT_STRING = "0.0", VISIBLE = 1;

CREATE MEMBER CURRENTCUBE.[Measures].[Avg Precipitation] AS
    IIF([Measures].[Fact Ev Charging Count] = 0, NULL, [Measures].[Precipitation Mm] / [Measures].[Fact Ev Charging Count]),
    FORMAT_STRING = "0.000", VISIBLE = 1;

CREATE MEMBER CURRENTCUBE.[Measures].[Avg Traffic] AS
    IIF([Measures].[Fact Ev Charging Count] = 0, NULL, [Measures].[Traffic Congestion Index] / [Measures].[Fact Ev Charging Count]),
    FORMAT_STRING = "0.000", VISIBLE = 1;

CREATE MEMBER CURRENTCUBE.[Measures].[Avg Ports Available] AS
    IIF([Measures].[Fact Ev Charging Count] = 0, NULL, [Measures].[Ports Available] / [Measures].[Fact Ev Charging Count]),
    FORMAT_STRING = "0.00", VISIBLE = 1;

CREATE MEMBER CURRENTCUBE.[Measures].[OOS Rate] AS
    IIF(([Measures].[Ports Occupied] + [Measures].[Ports Available] + [Measures].[Ports Out Of Service]) = 0, NULL,
        [Measures].[Ports Out Of Service] /
        ([Measures].[Ports Occupied] + [Measures].[Ports Available] + [Measures].[Ports Out Of Service])),
    FORMAT_STRING = "0.00%", VISIBLE = 1;

CREATE MEMBER CURRENTCUBE.[Measures].[Surge Exposure %] AS
    IIF([Measures].[Fact Ev Charging Count] = 0, NULL,
        ([Fact Ev Charging].[Utilization Level].&amp;[Near Capacity], [Measures].[Fact Ev Charging Count])
        / [Measures].[Fact Ev Charging Count]),
    FORMAT_STRING = "0.00%", VISIBLE = 1;

CREATE MEMBER CURRENTCUBE.[Measures].[Lost Port-Hours] AS
    [Measures].[Lost Demand Ports] * 0.5,
    FORMAT_STRING = "#,##0.0", VISIBLE = 1;

CREATE MEMBER CURRENTCUBE.[Measures].[Lost Demand %] AS
    IIF(([Measures].[Lost Demand Ports] + [Measures].[Ports Occupied]) = 0, NULL,
        [Measures].[Lost Demand Ports] / ([Measures].[Lost Demand Ports] + [Measures].[Ports Occupied])),
    FORMAT_STRING = "0.00%", VISIBLE = 1;

CREATE MEMBER CURRENTCUBE.[Measures].[Network Share In State] AS
    IIF(([Measures].[Ports Occupied], [Dim Station].[Network].[All]) = 0, NULL,
        [Measures].[Ports Occupied] / ([Measures].[Ports Occupied], [Dim Station].[Network].[All])),
    FORMAT_STRING = "0.00%", VISIBLE = 1;

/* ===== S2. Named Set ===== */
CREATE SET CURRENTCUBE.[Hours Offpeak] AS
    {[Dim Time].[Hour Of Day].&amp;[2] : [Dim Time].[Hour Of Day].&amp;[5]};
CREATE SET CURRENTCUBE.[Hours Morning] AS
    {[Dim Time].[Hour Of Day].&amp;[7] : [Dim Time].[Hour Of Day].&amp;[9]};
CREATE SET CURRENTCUBE.[Hours Midday] AS
    {[Dim Time].[Hour Of Day].&amp;[10] : [Dim Time].[Hour Of Day].&amp;[16]};
CREATE SET CURRENTCUBE.[Hours Evening] AS
    {[Dim Time].[Hour Of Day].&amp;[17] : [Dim Time].[Hour Of Day].&amp;[20]};

CREATE SET CURRENTCUBE.[Days Hot Season] AS
    {[Dim Date].[Date].&amp;[2025-07-01T00:00:00] : [Dim Date].[Date].&amp;[2025-09-30T00:00:00]};
CREATE SET CURRENTCUBE.[Days Cold Season] AS
    {[Dim Date].[Date].&amp;[2025-11-01T00:00:00] : [Dim Date].[Date].&amp;[2025-12-30T00:00:00]};

CREATE SET CURRENTCUBE.[Top 3 Cities Q4] AS
    TopCount([Dim Station].[Geography].[City].Members, 3,
             ([Dim Date].[Quarter].&amp;[2025]&amp;[4], [Measures].[Avg Utilization]));

/* ===== S3. Khung gio, Peak Lift, Peak Premium (Q5) ===== */
CREATE MEMBER CURRENTCUBE.[Measures].[Util Morning Peak] AS
    IIF(Sum([Hours Morning], [Measures].[Fact Ev Charging Count]) = 0, NULL,
        Sum([Hours Morning], [Measures].[Utilization Rate]) / Sum([Hours Morning], [Measures].[Fact Ev Charging Count])),
    FORMAT_STRING = "0.0000", VISIBLE = 1;

CREATE MEMBER CURRENTCUBE.[Measures].[Util Midday] AS
    IIF(Sum([Hours Midday], [Measures].[Fact Ev Charging Count]) = 0, NULL,
        Sum([Hours Midday], [Measures].[Utilization Rate]) / Sum([Hours Midday], [Measures].[Fact Ev Charging Count])),
    FORMAT_STRING = "0.0000", VISIBLE = 1;

CREATE MEMBER CURRENTCUBE.[Measures].[Util Evening Peak] AS
    IIF(Sum([Hours Evening], [Measures].[Fact Ev Charging Count]) = 0, NULL,
        Sum([Hours Evening], [Measures].[Utilization Rate]) / Sum([Hours Evening], [Measures].[Fact Ev Charging Count])),
    FORMAT_STRING = "0.0000", VISIBLE = 1;

CREATE MEMBER CURRENTCUBE.[Measures].[Peak Lift Morning] AS
    IIF([Measures].[Util Midday] = 0, NULL, [Measures].[Util Morning Peak] / [Measures].[Util Midday] - 1),
    FORMAT_STRING = "0.0%", VISIBLE = 1;

CREATE MEMBER CURRENTCUBE.[Measures].[Peak Lift Evening] AS
    IIF([Measures].[Util Midday] = 0, NULL, [Measures].[Util Evening Peak] / [Measures].[Util Midday] - 1),
    FORMAT_STRING = "0.0%", VISIBLE = 1;

CREATE MEMBER CURRENTCUBE.[Measures].[Price Evening] AS
    IIF(Sum([Hours Evening], [Measures].[Fact Ev Charging Count]) = 0, NULL,
        Sum([Hours Evening], [Measures].[Current Price]) / Sum([Hours Evening], [Measures].[Fact Ev Charging Count])),
    FORMAT_STRING = "0.0000", VISIBLE = 1;

CREATE MEMBER CURRENTCUBE.[Measures].[Price Offpeak] AS
    IIF(Sum([Hours Offpeak], [Measures].[Fact Ev Charging Count]) = 0, NULL,
        Sum([Hours Offpeak], [Measures].[Current Price]) / Sum([Hours Offpeak], [Measures].[Fact Ev Charging Count])),
    FORMAT_STRING = "0.0000", VISIBLE = 1;

CREATE MEMBER CURRENTCUBE.[Measures].[Peak Premium %] AS
    IIF([Measures].[Price Offpeak] = 0, NULL, [Measures].[Price Evening] / [Measures].[Price Offpeak] - 1),
    FORMAT_STRING = "0.0%", VISIBLE = 1;

/* ===== S4. Xep hang tram trong thanh pho (Q8) ===== */
CREATE MEMBER CURRENTCUBE.[Measures].[Station Rank In City] AS
    IIF([Dim Station].[Geography].CurrentMember.Level.Ordinal = 3
        AND NOT IsEmpty([Measures].[Avg Utilization]),
        Rank([Dim Station].[Geography].CurrentMember,
             Order(NonEmpty([Dim Station].[Geography].CurrentMember.Parent.Children, [Measures].[Fact Ev Charging Count]),
                   [Measures].[Avg Utilization], BASC)),
        NULL),
    FORMAT_STRING = "0", VISIBLE = 1;

/* ===== S5. Period-over-Period theo thang (Q7) ===== */
CREATE MEMBER CURRENTCUBE.[Measures].[Prev Month Utilization] AS
    (ParallelPeriod([Dim Date].[Calendar].[Month], 1, [Dim Date].[Calendar].CurrentMember),
     [Measures].[Avg Utilization]),
    FORMAT_STRING = "0.0000", VISIBLE = 1;

CREATE MEMBER CURRENTCUBE.[Measures].[MoM Utilization %] AS
    IIF([Measures].[Prev Month Utilization] = 0 OR IsEmpty([Measures].[Prev Month Utilization]), NULL,
        ([Measures].[Avg Utilization] - [Measures].[Prev Month Utilization]) / [Measures].[Prev Month Utilization]),
    FORMAT_STRING = "0.0%", VISIBLE = 1;

CREATE MEMBER CURRENTCUBE.[Measures].[Prev Month Gas] AS
    (ParallelPeriod([Dim Date].[Calendar].[Month], 1, [Dim Date].[Calendar].CurrentMember),
     [Measures].[Avg Gas]),
    FORMAT_STRING = "0.000", VISIBLE = 1;

CREATE MEMBER CURRENTCUBE.[Measures].[MoM Gas %] AS
    IIF([Measures].[Prev Month Gas] = 0 OR IsEmpty([Measures].[Prev Month Gas]), NULL,
        ([Measures].[Avg Gas] - [Measures].[Prev Month Gas]) / [Measures].[Prev Month Gas]),
    FORMAT_STRING = "0.0%", VISIBLE = 1;

/* ===== S6. Cumulative (Q9) ===== */
CREATE MEMBER CURRENTCUBE.[Measures].[Cumulative Lost Port-Hours] AS
    IIF(IsEmpty(Sum(PeriodsToDate([Dim Date].[Calendar].[Year], [Dim Date].[Calendar].CurrentMember),
                    [Measures].[Lost Demand Ports])), NULL,
        Sum(PeriodsToDate([Dim Date].[Calendar].[Year], [Dim Date].[Calendar].CurrentMember),
            [Measures].[Lost Demand Ports]) * 0.5),
    FORMAT_STRING = "#,##0.0", VISIBLE = 1;

CREATE MEMBER CURRENTCUBE.[Measures].[Cumulative Lost Demand %] AS
    IIF(IsEmpty(Sum(PeriodsToDate([Dim Date].[Calendar].[Year], [Dim Date].[Calendar].CurrentMember),
                    [Measures].[Lost Demand Ports])), NULL,
        Sum(PeriodsToDate([Dim Date].[Calendar].[Year], [Dim Date].[Calendar].CurrentMember), [Measures].[Lost Demand Ports]) /
        (Sum(PeriodsToDate([Dim Date].[Calendar].[Year], [Dim Date].[Calendar].CurrentMember), [Measures].[Lost Demand Ports]) +
         Sum(PeriodsToDate([Dim Date].[Calendar].[Year], [Dim Date].[Calendar].CurrentMember), [Measures].[Ports Occupied]))),
    FORMAT_STRING = "0.00%", VISIBLE = 1;

/* ===== S7. Tuong quan theo ngay (Q12) ===== */
CREATE MEMBER CURRENTCUBE.[Measures].[r Traffic Hot] AS
    Correlation([Days Hot Season], [Measures].[Avg Utilization], [Measures].[Avg Traffic]),
    FORMAT_STRING = "0.0000", VISIBLE = 1;
CREATE MEMBER CURRENTCUBE.[Measures].[r Rain Hot] AS
    Correlation([Days Hot Season], [Measures].[Avg Utilization], [Measures].[Avg Precipitation]),
    FORMAT_STRING = "0.0000", VISIBLE = 1;
CREATE MEMBER CURRENTCUBE.[Measures].[r Temp Hot] AS
    Correlation([Days Hot Season], [Measures].[Avg Utilization], [Measures].[Avg Temperature]),
    FORMAT_STRING = "0.0000", VISIBLE = 1;
CREATE MEMBER CURRENTCUBE.[Measures].[r Traffic Cold] AS
    Correlation([Days Cold Season], [Measures].[Avg Utilization], [Measures].[Avg Traffic]),
    FORMAT_STRING = "0.0000", VISIBLE = 1;
CREATE MEMBER CURRENTCUBE.[Measures].[r Rain Cold] AS
    Correlation([Days Cold Season], [Measures].[Avg Utilization], [Measures].[Avg Precipitation]),
    FORMAT_STRING = "0.0000", VISIBLE = 1;
CREATE MEMBER CURRENTCUBE.[Measures].[r Temp Cold] AS
    Correlation([Days Cold Season], [Measures].[Avg Utilization], [Measures].[Avg Temperature]),
    FORMAT_STRING = "0.0000", VISIBLE = 1;

/* ===== S8. Composite Rank van hanh (Q11) ===== */
CREATE MEMBER CURRENTCUBE.[Measures].[Rank Util Evening] AS
    IIF(IsEmpty([Measures].[Util Evening Peak]), NULL,
        Rank([Dim Station].[Network].CurrentMember,
             Order(NonEmpty([Dim Station].[Network].[Network].Members, [Measures].[Util Evening Peak]),
                   [Measures].[Util Evening Peak], BDESC))),
    FORMAT_STRING = "0", VISIBLE = 1;

CREATE MEMBER CURRENTCUBE.[Measures].[Rank Surge] AS
    IIF(IsEmpty([Measures].[Surge Exposure %]), NULL,
        Rank([Dim Station].[Network].CurrentMember,
             Order(NonEmpty([Dim Station].[Network].[Network].Members, [Measures].[Surge Exposure %]),
                   [Measures].[Surge Exposure %], BDESC))),
    FORMAT_STRING = "0", VISIBLE = 1;

CREATE MEMBER CURRENTCUBE.[Measures].[Rank Wait] AS
    IIF(IsEmpty([Measures].[Avg Wait]), NULL,
        Rank([Dim Station].[Network].CurrentMember,
             Order(NonEmpty([Dim Station].[Network].[Network].Members, [Measures].[Avg Wait]),
                   [Measures].[Avg Wait], BDESC))),
    FORMAT_STRING = "0", VISIBLE = 1;

CREATE MEMBER CURRENTCUBE.[Measures].[Composite Rank] AS
    IIF(IsEmpty([Measures].[Rank Util Evening]) OR IsEmpty([Measures].[Rank Surge]) OR IsEmpty([Measures].[Rank Wait]),
        NULL,
        ([Measures].[Rank Util Evening] + [Measures].[Rank Surge] + [Measures].[Rank Wait]) / 3.0),
    FORMAT_STRING = "0.00", VISIBLE = 1;

/* ===== S9. Period-over-Period theo Quarter (Q14) ===== */
CREATE MEMBER CURRENTCUBE.[Measures].[Prev Quarter Utilization] AS
    (ParallelPeriod([Dim Date].[Calendar].[Quarter], 1, [Dim Date].[Calendar].CurrentMember),
     [Measures].[Avg Utilization]),
    FORMAT_STRING = "0.0000", VISIBLE = 1;

CREATE MEMBER CURRENTCUBE.[Measures].[QoQ Utilization %] AS
    IIF([Measures].[Prev Quarter Utilization] = 0 OR IsEmpty([Measures].[Prev Quarter Utilization]), NULL,
        ([Measures].[Avg Utilization] - [Measures].[Prev Quarter Utilization]) / [Measures].[Prev Quarter Utilization]),
    FORMAT_STRING = "0.0%", VISIBLE = 1;

CREATE MEMBER CURRENTCUBE.[Measures].[Prev Quarter OOS] AS
    (ParallelPeriod([Dim Date].[Calendar].[Quarter], 1, [Dim Date].[Calendar].CurrentMember),
     [Measures].[OOS Rate]),
    FORMAT_STRING = "0.00%", VISIBLE = 1;</Text>
        </Command>
      </Commands>
    </MdxScript>
  </MdxScripts>
</Cube>