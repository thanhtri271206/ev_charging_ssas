        <Measure dwd:design-time-name="32c07954-da5e-46db-8162-28381b8270a0">
          <ID>Traffic Congestion Index</ID>
          <Name>Traffic Congestion Index</Name>
          <Source dwd:design-time-name="53386ec3-b394-4a3b-b805-e85cedcc3759">
            <DataType>Double</DataType>
            <Source xsi:type="ColumnBinding" dwd:design-time-name="dfc22cbc-a67f-483b-9053-48e8f29cbf16">
              <TableID>dbo_fact_ev_charging</TableID>
              <ColumnID>traffic_congestion_index</ColumnID>
            </Source>
          </Source>
        </Measure>
        <Measure dwd:design-time-name="708c2b42-7202-4cc0-bf99-0b6448dd2b63">
          <ID>Lost Demand Ports</ID>
          <Name>Lost Demand Ports</Name>
          <Source dwd:design-time-name="a0945b1a-be90-409e-9923-4177adacf663">
            <DataType>Double</DataType>
            <Source xsi:type="ColumnBinding" dwd:design-time-name="bb59fc34-137d-4667-afdf-7e9447e01437">
              <TableID>dbo_fact_ev_charging</TableID>
              <ColumnID>lost_demand_ports</ColumnID>
            </Source>
          </Source>
        </Measure>
        <Measure dwd:design-time-name="f3c6e426-bff1-437a-8f77-4a451d067e68">
          <ID>Fact Ev Charging Count</ID>
          <Name>Fact Ev Charging Count</Name>
          <AggregateFunction>Count</AggregateFunction>
          <Source dwd:design-time-name="0ef5a13d-438a-442a-89a1-11f8ca84c4b0">
            <DataType>Integer</DataType>
            <DataSize>4</DataSize>
            <Source xsi:type="RowBinding" dwd:design-time-name="59801293-e0ca-48f9-9228-38741dbb7471">
              <TableID>dbo_fact_ev_charging</TableID>
            </Source>
          </Source>
        </Measure>
      </Measures>
      <StorageMode>Molap</StorageMode>
      <ProcessingMode>Regular</ProcessingMode>
      <Dimensions>
