          <CubeDimensionID>Fact Ev Charging</CubeDimensionID>
          <Attributes>
            <Attribute dwd:design-time-name="338f0204-a8ec-4ae8-b718-dd109257077c">
              <AttributeID>Fact Id</AttributeID>
              <KeyColumns>
                <KeyColumn dwd:design-time-name="7a51ce16-986c-4d5e-a277-da5caf0bbb23">
                  <DataType>BigInt</DataType>
                  <Source xsi:type="ColumnBinding" dwd:design-time-name="01e96038-8cd8-4038-84ac-df9a8dde57ae">
                    <TableID>dbo_fact_ev_charging</TableID>
